"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Allowed (GLPI default behavior)"
msgstr "Permitido (comportamento padrão do GLPI)"

msgid "Block solution approval when there is a comment"
msgstr "Bloquear a aprovação da solução quando houver comentário"

msgid "Comments during solution approval"
msgstr "Comentários durante a aprovação da solução"

msgid "Configuration saved successfully."
msgstr "Configuração salva com sucesso."

msgid "Error saving configuration."
msgstr "Erro ao salvar a configuração."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Não é permitido inserir comentários ao aprovar uma solução. Por favor, deixe"
" a caixa de texto vazia ou recuse a solução."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Exibir aviso ao usuário, permitindo a aprovação"

msgid "Solution Approval Guard"
msgstr "Guardião de Aprovação de Soluções"

msgid "Solution Approval Settings"
msgstr "Configurações de Aprovação de Soluções"

msgid "Solution approved"
msgstr "Solução aprovada"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Aviso: Sua solução foi aprovada, mas para relatar pendências você deve "
"recusar a solução ou abrir um novo chamado."
