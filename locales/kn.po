msgid "Allowed (GLPI default behavior)"
msgstr "ಅನುಮತಿಸಲಾಗಿದೆ (GLPI ಡೀಫಾಲ್ಟ್ ನಡವಳಿಕೆ)"

msgid "Block solution approval when there is a comment"
msgstr "ಕಾಮೆಂಟ್ ಇದ್ದಾಗ ಪರಿಹಾರ ಅನುಮೋದನೆಯನ್ನು ನಿರ್ಬಂಧಿಸಿ"

msgid "Comments during solution approval"
msgstr "ಪರಿಹಾರ ಅನುಮೋದನೆಯ ಸಮಯದಲ್ಲಿ ಕಾಮೆಂಟ್‌ಗಳು"

msgid "Configuration saved successfully."
msgstr "ಸಂರಚನೆಯನ್ನು ಯಶಸ್ವಿಯಾಗಿ ಉಳಿಸಲಾಗಿದೆ."

msgid "Error saving configuration."
msgstr "ಸಂರಚನೆಯನ್ನು ಉಳಿಸುವಾಗ ದೋಷ."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"ಪರಿಹಾರವನ್ನು ಅನುಮೋದಿಸುವಾಗ ಕಾಮೆಂಟ್‌ಗಳನ್ನು ನಮೂದಿಸಲು ಅನುಮತಿಸಲಾಗುವುದಿಲ್ಲ. "
"ದಯವಿಟ್ಟು ಪಠ್ಯ ಪೆಟ್ಟಿಗೆಯನ್ನು ಖಾಲಿ ಬಿಡಿ ಅಥವಾ ಪರಿಹಾರವನ್ನು ನಿರಾಕರಿಸಿ."

msgid "Show warning to the user, allowing the solution approval"
msgstr "ಬಳಕೆದಾರರಿಗೆ ಎಚ್ಚರಿಕೆಯನ್ನು ತೋರಿಸಿ, ಅನುಮೋದನೆಯನ್ನು ಅನುಮತಿಸುತ್ತದೆ"

msgid "Solution Approval Guard"
msgstr "ಪರಿಹಾರ ಅನುಮೋದನೆ ಗಾರ್ಡ್"

msgid "Solution Approval Settings"
msgstr "ಪರಿಹಾರ ಅನುಮೋದನೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "Solution approved"
msgstr "ಪರಿಹಾರವನ್ನು ಅನುಮೋದಿಸಲಾಗಿದೆ"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"ಎಚ್ಚರಿಕೆ: ನಿಮ್ಮ ಪರಿಹಾರವನ್ನು ಅನುಮೋದಿಸಲಾಗಿದೆ, ಆದರೆ ಬಾಕಿ ಇರುವ ಸಮಸ್ಯೆಗಳನ್ನು ವರದಿ"
" ಮಾಡಲು ನೀವು ಪರಿಹಾರವನ್ನು ನಿರಾಕರಿಸಬೇಕು ಅಥವಾ ಹೊಸ ಟಿಕೆಟ್ ಅನ್ನು ತೆರೆಯಬೇಕು."
