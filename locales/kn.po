msgid "Show a warning to the user, allowing approval only after additional confirmation"
msgstr "ಬಳಕೆದಾರರಿಗೆ ಎಚ್ಚರಿಕೆಯನ್ನು ತೋರಿಸಿ, ಹೆಚ್ಚುವರಿ ದೃಢೀಕರಣದ ನಂತರ ಮಾತ್ರ ಅನುಮೋದನೆಗೆ ಅವಕಾಶ ನೀಡಿ"

msgid ""
msgstr ""
"Project-Id-Version: SolutionApprovalGuard 1.0\n"
"Language: kn\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Allowed (GLPI default behavior)"
msgstr "ಅನುಮತಿಸಲಾಗಿದೆ (GLPI ಡೀಫಾಲ್ಟ್ ನಡವಳಿಕೆ)"

msgid "Block solution approval when there is a comment"
msgstr "ಕಾಮೆಂಟ್ ಇದ್ದಾಗ ಪರಿಹಾರ ಅನುಮೋದನೆಯನ್ನು ನಿರ್ಬಂಧಿಸಿ"

msgid "Comments during solution approval"
msgstr "ಪರಿಹಾರ ಅನುಮೋದನೆಯ ಸಮಯದಲ್ಲಿ ಕಾಮೆಂಟ್‌ಗಳು"

msgid "Configuration saved successfully."
msgstr "ಸಂರಚನೆಯನ್ನು ಯಶಸ್ವಿಯಾಗಿ ಉಳಿಸಲಾಗಿದೆ."

msgid "Error saving configuration."
msgstr "ಸಂರಚನೆಯನ್ನು ಉಳಿಸುವಾಗ ದೋಷ."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"ಪರಿಹಾರವನ್ನು ಅನುಮೋದಿಸುವಾಗ ಕಾಮೆಂಟ್‌ಗಳನ್ನು ನಮೂದಿಸಲು ಅನುಮತಿಸಲಾಗುವುದಿಲ್ಲ. "
"ದಯವಿಟ್ಟು ಪಠ್ಯ ಪೆಟ್ಟಿಗೆಯನ್ನು ಖಾಲಿ ಬಿಡಿ ಅಥವಾ ಪರಿಹಾರವನ್ನು ನಿರಾಕರಿಸಿ."

msgid "Show warning to the user, allowing the solution approval"
msgstr "ಬಳಕೆದಾರರಿಗೆ ಎಚ್ಚರಿಕೆಯನ್ನು ತೋರಿಸಿ, ಅನುಮೋದನೆಯನ್ನು ಅನುಮತಿಸುತ್ತದೆ"

msgid "Solution Approval Guard"
msgstr "ಪರಿಹಾರ ಅನುಮೋದನೆ ಗಾರ್ಡ್"

msgid "Solution Approval Settings"
msgstr "ಪರಿಹಾರ ಅನುಮೋದನೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "Solution approved"
msgstr "ಪರಿಹಾರವನ್ನು ಅನುಮೋದಿಸಲಾಗಿದೆ"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"ಎಚ್ಚರಿಕೆ: ನಿಮ್ಮ ಪರಿಹಾರವನ್ನು ಅನುಮೋದಿಸಲಾಗಿದೆ, ಆದರೆ ಬಾಕಿ ಇರುವ ಸಮಸ್ಯೆಗಳನ್ನು ವರದಿ"
" ಮಾಡಲು ನೀವು ಪರಿಹಾರವನ್ನು ನಿರಾಕರಿಸಬೇಕು ಅಥವಾ ಹೊಸ ಟಿಕೆಟ್ ಅನ್ನು ತೆರೆಯಬೇಕು."

msgid "Approval with a comment is allowed immediately. A warning is displayed after submission to explain that pending issues should be reported by refusing the solution or opening a new ticket. No additional confirmation is requested and approval is not blocked."
msgstr "ಕಾಮೆಂಟ್‌ನೊಂದಿಗೆ ಅನುಮೋದನೆಯನ್ನು ತಕ್ಷಣವೇ ಅನುಮತಿಸಲಾಗಿದೆ. ಪರಿಹಾರವನ್ನು ನಿರಾಕರಿಸುವ ಮೂಲಕ ಅಥವಾ ಹೊಸ ಟಿಕೆಟ್ ತೆರೆಯುವ ಮೂಲಕ ಬಾಕಿ ಇರುವ ಸಮಸ್ಯೆಗಳನ್ನು ವರದಿ ಮಾಡಬೇಕು ಎಂದು ವಿವರಿಸಲು ಸಲ್ಲಿಸಿದ ನಂತರ ಎಚ್ಚರಿಕೆಯನ್ನು ಪ್ರದರ್ಶಿಸಲಾಗುತ್ತದೆ. ಯಾವುದೇ ಹೆಚ್ಚುವರಿ ದೃಢೀಕರಣವನ್ನು ವಿನಂತಿಸಲಾಗಿಲ್ಲ ಮತ್ತು ಅನುಮೋದನೆಯನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿಲ್ಲ."

msgid "Approval is blocked on the server when the comment contains text. To approve, the user must clear the comment; if the problem persists, they should refuse the solution instead. Empty HTML tags and spaces alone are not considered a comment."
msgstr "ಕಾಮೆಂಟ್ ಪಠ್ಯವನ್ನು ಹೊಂದಿರುವಾಗ ಸರ್ವರ್‌ನಲ್ಲಿ ಅನುಮೋದನೆಯನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ. ಅನುಮೋದಿಸಲು, ಬಳಕೆದಾರರು ಕಾಮೆಂಟ್ ಅನ್ನು ತೆರವುಗೊಳಿಸಬೇಕು; ಸಮಸ್ಯೆ ಮುಂದುವರಿದರೆ, ಅವರು ಪರಿಹಾರವನ್ನು ನಿರಾಕರಿಸಬೇಕು. ಖಾಲಿ HTML ಟ್ಯಾಗ್‌ಗಳು ಮತ್ತು ಸ್ಪೇಸ್‌ಗಳನ್ನು ಮಾತ್ರ ಕಾಮೆಂಟ್ ಎಂದು ಪರಿಗಣಿಸಲಾಗುವುದಿಲ್ಲ."

msgid "When the user approves a solution with a comment, a confirmation dialog is displayed before submission. Approve anyway continues the approval with the comment. Cancel, Escape or closing the dialog keeps the comment without submitting the approval. If the problem persists, the user should cancel and refuse the solution instead. Empty comments do not require additional confirmation."
msgstr "ಬಳಕೆದಾರರು ಕಾಮೆಂಟ್‌ನೊಂದಿಗೆ ಪರಿಹಾರವನ್ನು ಅನುಮೋದಿಸಿದಾಗ, ಸಲ್ಲಿಸುವ ಮೊದಲು ದೃಢೀಕರಣ ಸಂವಾದವನ್ನು ಪ್ರದರ್ಶಿಸಲಾಗುತ್ತದೆ. ಹೇಗಾದರೂ ಅನುಮೋದಿಸಿ ಕಾಮೆಂಟ್‌ನೊಂದಿಗೆ ಅನುಮೋದನೆಯನ್ನು ಮುಂದುವರಿಸುತ್ತದೆ. ಸಂವಾದವನ್ನು ರದ್ದುಗೊಳಿಸುವುದು, ತಪ್ಪಿಸಿಕೊಳ್ಳುವುದು ಅಥವಾ ಮುಚ್ಚುವುದು ಅನುಮೋದನೆಯನ್ನು ಸಲ್ಲಿಸದೆಯೇ ಕಾಮೆಂಟ್ ಅನ್ನು ಇರಿಸುತ್ತದೆ. ಸಮಸ್ಯೆ ಮುಂದುವರಿದರೆ, ಬಳಕೆದಾರರು ರದ್ದುಗೊಳಿಸಬೇಕು ಮತ್ತು ಬದಲಿಗೆ ಪರಿಹಾರವನ್ನು ನಿರಾಕರಿಸಬೇಕು. ಖಾಲಿ ಕಾಮೆಂಟ್‌ಗಳಿಗೆ ಹೆಚ್ಚುವರಿ ದೃಢೀಕರಣದ ಅಗತ್ಯವಿರುವುದಿಲ್ಲ."
