msgid "Allowed (GLPI default behavior)"
msgstr "Tillatt (GLPI standardatferd)"

msgid "Block solution approval when there is a comment"
msgstr "Blokker løsningsgodkjenning når det er en kommentar"

msgid "Comments during solution approval"
msgstr "Kommentarer under løsningsgodkjenning"

msgid "Configuration saved successfully."
msgstr "Konfigurasjonen ble lagret."

msgid "Error saving configuration."
msgstr "Feil ved lagring av konfigurasjon."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Det er ikke tillatt å skrive inn kommentarer når du godkjenner en løsning. "
"La tekstboksen stå tom eller avvis løsningen."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Vis advarsel til brukeren, tillat godkjenning"

msgid "Solution Approval Guard"
msgstr "Løsningsgodkjenningsvakt"

msgid "Solution Approval Settings"
msgstr "Innstillinger for Løsningsgodkjenning"

msgid "Solution approved"
msgstr "Løsning godkjent"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Advarsel: Løsningen din ble godkjent, men for å rapportere ventende "
"problemer må du avvise løsningen eller åpne en ny sak."
