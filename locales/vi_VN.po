msgid "Allowed (GLPI default behavior)"
msgstr "Được phép (hành vi mặc định của GLPI)"

msgid "Block solution approval when there is a comment"
msgstr "Chặn phê duyệt giải pháp khi có nhận xét"

msgid "Comments during solution approval"
msgstr "Nhận xét trong quá trình phê duyệt giải pháp"

msgid "Configuration saved successfully."
msgstr "Cấu hình đã được lưu thành công."

msgid "Error saving configuration."
msgstr "Lỗi khi lưu cấu hình."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Không được phép nhập nhận xét khi phê duyệt giải pháp. Vui lòng để trống hộp"
" văn bản hoặc từ chối giải pháp."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Hiển thị cảnh báo cho người dùng, cho phép phê duyệt"

msgid "Solution Approval Guard"
msgstr "Người bảo vệ Phê duyệt Giải pháp"

msgid "Solution Approval Settings"
msgstr "Cài đặt Phê duyệt Giải pháp"

msgid "Solution approved"
msgstr "Giải pháp đã được phê duyệt"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Cảnh báo: Giải pháp của bạn đã được phê duyệt, nhưng để báo cáo các vấn đề "
"đang chờ xử lý, bạn phải từ chối giải pháp hoặc mở một vé mới."
