msgid "Allowed (GLPI default behavior)"
msgstr "E lejuar (Sjellja e parazgjedhur e GLPI)"

msgid "Block solution approval when there is a comment"
msgstr "Blloko miratimin e zgjidhjes kur ka një koment"

msgid "Comments during solution approval"
msgstr "Komentet gjatë miratimit të zgjidhjes"

msgid "Configuration saved successfully."
msgstr "Konfigurimi u ruajt me sukses."

msgid "Error saving configuration."
msgstr "Gabim gjatë ruajtjes së konfigurimit."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Nuk lejohet të jepni komente kur miratoni një zgjidhje. Ju lutemi lëreni "
"kutinë e tekstit bosh ose refuzoni zgjidhjen."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Trego paralajmërim përdoruesit, duke lejuar miratimin"

msgid "Solution Approval Guard"
msgstr "Mbrojtësi i Miratimit të Zgjidhjes"

msgid "Solution Approval Settings"
msgstr "Cilësimet e Miratimit të Zgjidhjes"

msgid "Solution approved"
msgstr "Zgjidhja u miratua"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Paralajmërim: Zgjidhja juaj u miratua, por për të raportuar çështjet në "
"pritje duhet të refuzoni zgjidhjen ose të hapni një tiketë të re."
