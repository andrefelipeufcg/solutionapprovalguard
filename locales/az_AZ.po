msgid "Show a warning to the user, allowing approval only after additional confirmation"
msgstr "İstifadəçiyə xəbərdarlıq göstər, təsdiqə yalnız əlavə təsdiqləmədən sonra icazə ver"

msgid ""
msgstr ""
