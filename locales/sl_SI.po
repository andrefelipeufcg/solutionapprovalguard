"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Allowed (GLPI default behavior)"
msgstr "Dovoljeno (privzeto vedenje GLPI)"

msgid "Block solution approval when there is a comment"
msgstr "Blokiraj odobritev rešitve, ko obstaja komentar"

msgid "Comments during solution approval"
msgstr "Komentarji med odobritvijo rešitve"

msgid "Configuration saved successfully."
msgstr "Konfiguracija je uspešno shranjena."

msgid "Error saving configuration."
msgstr "Napaka pri shranjevanju konfiguracije."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Pri odobritvi rešitve ni dovoljeno vnesti komentarjev. Pustite besedilno "
"polje prazno ali zavrnite rešitev."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Prikaži opozorilo uporabniku, dovoli odobritev"

msgid "Solution Approval Guard"
msgstr "Varnostnik Odobritve Rešitve"

msgid "Solution Approval Settings"
msgstr "Nastavitve Odobritve Rešitve"

msgid "Solution approved"
msgstr "Rešitev odobrena"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Opozorilo: Vaša rešitev je bila odobrena, vendar morate za prijavo nerešenih"
" težav zavrniti rešitev ali odpreti nov zadevek."
