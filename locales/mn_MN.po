msgid "Allowed (GLPI default behavior)"
msgstr "Зөвшөөрсөн (GLPI-ийн анхдагч үйлдэл)"

msgid "Block solution approval when there is a comment"
msgstr "Сэтгэгдэл байвал шийдэл батлахыг хориглох"

msgid "Comments during solution approval"
msgstr "Шийдэл батлах үеийн сэтгэгдлүүд"

msgid "Configuration saved successfully."
msgstr "Тохиргоог амжилттай хадгаллаа."

msgid "Error saving configuration."
msgstr "Тохиргоог хадгалахад алдаа гарлаа."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Шийдлийг батлах үед сэтгэгдэл оруулахыг хориглоно. Текст оруулах хэсгийг "
"хоосон үлдээх эсвэл шийдлээс татгалзана уу."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Хэрэглэгчид анхааруулга харуулах, батлахыг зөвшөөрөх"

msgid "Solution Approval Guard"
msgstr "Шийдэл Батлах Хамгаалагч"

msgid "Solution Approval Settings"
msgstr "Шийдэл Батлах Тохиргоо"

msgid "Solution approved"
msgstr "Шийдлийг баталсан"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Анхааруулга: Таны шийдлийг баталсан боловч хүлээгдэж буй асуудлуудыг "
"мэдээлэхийн тулд та шийдлээс татгалзах эсвэл шинэ тасалбар нээх ёстой."
