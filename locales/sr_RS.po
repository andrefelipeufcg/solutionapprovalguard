msgid "Allowed (GLPI default behavior)"
msgstr "Dozvoljeno (podrazumevano ponašanje GLPI-ja)"

msgid "Block solution approval when there is a comment"
msgstr "Blokiraj odobrenje rešenja kada postoji komentar"

msgid "Comments during solution approval"
msgstr "Komentari tokom odobrenja rešenja"

msgid "Configuration saved successfully."
msgstr "Конфигурација је успешно сачувана."

msgid "Error saving configuration."
msgstr "Грешка при чувању конфигурације."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Nije dozvoljeno unositi komentare prilikom odobravanja rešenja. Ostavite "
"tekstualno polje praznim ili odbijte rešenje."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Prikaži upozorenje korisniku, dozvoli odobrenje"

msgid "Solution Approval Guard"
msgstr "Čuvar Odobrenja Rešenja"

msgid "Solution Approval Settings"
msgstr "Podešavanja Odobrenja Rešenja"

msgid "Solution approved"
msgstr "Rešenje odobreno"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Upozorenje: Vaše rešenje je odobreno, ali da biste prijavili probleme na "
"čekanju morate odbiti rešenje ili otvoriti novi tiket."
