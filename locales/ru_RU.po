msgid "Allowed (GLPI default behavior)"
msgstr "Разрешено (поведение GLPI по умолчанию)"

msgid "Block solution approval when there is a comment"
msgstr "Блокировать утверждение решения при наличии комментария"

msgid "Comments during solution approval"
msgstr "Комментарии при утверждении решения"

msgid "Configuration saved successfully."
msgstr "Конфигурация успешно сохранена."

msgid "Error saving configuration."
msgstr "Ошибка при сохранении конфигурации."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Ввод комментариев при утверждении решения не допускается. Пожалуйста, "
"оставьте текстовое поле пустым или отклоните решение."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Показать предупреждение пользователю, разрешив утверждение"

msgid "Solution Approval Guard"
msgstr "Защитник Утверждения Решений"

msgid "Solution Approval Settings"
msgstr "Настройки Утверждения Решений"

msgid "Solution approved"
msgstr "Решение утверждено"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Предупреждение: Ваше решение было утверждено, но чтобы сообщить о нерешенных"
" проблемах, вы должны отклонить решение или открыть новую заявку."
