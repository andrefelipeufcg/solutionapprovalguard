msgid "Allowed (GLPI default behavior)"
msgstr "Επιτρέπεται (προεπιλεγμένη συμπεριφορά GLPI)"

msgid "Block solution approval when there is a comment"
msgstr "Αποκλεισμός έγκρισης λύσης όταν υπάρχει σχόλιο"

msgid "Comments during solution approval"
msgstr "Σχόλια κατά την έγκριση της λύσης"

msgid "Configuration saved successfully."
msgstr "Η διαμόρφωση αποθηκεύτηκε με επιτυχία."

msgid "Error saving configuration."
msgstr "Σφάλμα κατά την αποθήκευση της διαμόρφωσης."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Δεν επιτρέπεται η εισαγωγή σχολίων κατά την έγκριση μιας λύσης. Αφήστε το "
"πλαίσιο κειμένου κενό ή απορρίψτε τη λύση."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Εμφάνιση προειδοποίησης στον χρήστη, επιτρέποντας την έγκριση"

msgid "Solution Approval Guard"
msgstr "Φρουρός Έγκρισης Λύσης"

msgid "Solution Approval Settings"
msgstr "Ρυθμίσεις Έγκρισης Λύσης"

msgid "Solution approved"
msgstr "Η λύση εγκρίθηκε"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Προειδοποίηση: Η λύση σας εγκρίθηκε, αλλά για να αναφέρετε εκκρεμή ζητήματα "
"πρέπει να απορρίψετε τη λύση ή να ανοίξετε ένα νέο εισιτήριο."
