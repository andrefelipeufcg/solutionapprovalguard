msgid "Allowed (GLPI default behavior)"
msgstr "Permitido (comportamiento predeterminado de GLPI)"

msgid "Block solution approval when there is a comment"
msgstr "Bloquear la aprobación de la solución cuando haya un comentario"

msgid "Comments during solution approval"
msgstr "Comentarios durante la aprobación de la solución"

msgid "Configuration saved successfully."
msgstr "Configuración guardada correctamente."

msgid "Error saving configuration."
msgstr "Error al guardar la configuración."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"No está permitido ingresar comentarios al aprobar una solución. Por favor, "
"deje el cuadro de texto vacío o rechace la solución."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Mostrar advertencia al usuario, permitiendo la aprobación"

msgid "Solution Approval Guard"
msgstr "Guardián de Aprobación de Soluciones"

msgid "Solution Approval Settings"
msgstr "Ajustes de Aprobación de Soluciones"

msgid "Solution approved"
msgstr "Solución aprobada"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Advertencia: Su solución fue aprobada, pero para informar problemas "
"pendientes debe rechazar la solución o abrir un nuevo ticket."
