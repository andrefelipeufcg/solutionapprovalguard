msgid "Allowed (GLPI default behavior)"
msgstr "Permis (comportament implicit GLPI)"

msgid "Block solution approval when there is a comment"
msgstr "Blocați aprobarea soluției când există un comentariu"

msgid "Comments during solution approval"
msgstr "Comentarii în timpul aprobării soluției"

msgid "Configuration saved successfully."
msgstr "Configurația a fost salvată cu succes."

msgid "Error saving configuration."
msgstr "Eroare la salvarea configurației."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Nu este permisă introducerea de comentarii la aprobarea unei soluții. Vă "
"rugăm să lăsați caseta de text goală sau să refuzați soluția."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Afișați un avertisment utilizatorului, permițând aprobarea"

msgid "Solution Approval Guard"
msgstr "Gardianul Aprobării Soluțiilor"

msgid "Solution Approval Settings"
msgstr "Setări pentru Aprobarea Soluției"

msgid "Solution approved"
msgstr "Soluție aprobată"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Avertisment: Soluția dvs. a fost aprobată, dar pentru a raporta probleme în "
"așteptare trebuie să refuzați soluția sau să deschideți un tichet nou."
