msgid "Allowed (GLPI default behavior)"
msgstr "Permitido (comportamento predeterminado de GLPI)"

msgid "Block solution approval when there is a comment"
msgstr "Bloquear a aprobación da solución cando haxa un comentario"

msgid "Comments during solution approval"
msgstr "Comentarios durante a aprobación da solución"

msgid "Configuration saved successfully."
msgstr "A configuración gardouse correctamente."

msgid "Error saving configuration."
msgstr "Erro ao gardar a configuración."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Non está permitido introducir comentarios ao aprobar unha solución. Por "
"favor, deixe a caixa de texto baleira ou rexeite a solución."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Mostrar aviso ao usuario, permitindo a aprobación"

msgid "Solution Approval Guard"
msgstr "Gardián de Aprobación de Solucións"

msgid "Solution Approval Settings"
msgstr "Axustes de Aprobación de Solucións"

msgid "Solution approved"
msgstr "Solución aprobada"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Aviso: A súa solución foi aprobada, pero para informar problemas pendentes "
"debe rexeitar a solución ou abrir un novo ticket."
