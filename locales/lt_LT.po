msgid "Allowed (GLPI default behavior)"
msgstr "Leidžiama (numatytasis GLPI elgesys)"

msgid "Block solution approval when there is a comment"
msgstr "Blokuoti sprendimo patvirtinimą, kai yra komentaras"

msgid "Comments during solution approval"
msgstr "Komentarai sprendimo patvirtinimo metu"

msgid "Configuration saved successfully."
msgstr "Konfigūracija sėkmingai išsaugota."

msgid "Error saving configuration."
msgstr "Klaida išsaugant konfigūraciją."

msgid ""
"It is not allowed to enter comments when approving a solution. Please leave "
"the text box empty or refuse the solution."
msgstr ""
"Patvirtinant sprendimą neleidžiama įvesti komentarų. Prašome palikti teksto "
"laukelį tuščią arba atmesti sprendimą."

msgid "Show warning to the user, allowing the solution approval"
msgstr "Rodyti įspėjimą vartotojui, leidžiant patvirtinti"

msgid "Solution Approval Guard"
msgstr "Sprendimų Patvirtinimo Sergėtojas"

msgid "Solution Approval Settings"
msgstr "Sprendimų Patvirtinimo Nustatymai"

msgid "Solution approved"
msgstr "Sprendimas patvirtintas"

msgid ""
"Warning: Your solution was approved, but to report pending issues you must "
"refuse the solution or open a new ticket."
msgstr ""
"Įspėjimas: Jūsų sprendimas buvo patvirtintas, bet norėdami pranešti apie "
"laukiančias problemas, turite atmesti sprendimą arba atidaryti naują "
"bilietą."
